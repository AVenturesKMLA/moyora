# MongoDB Connection
# Replace <db_password> with your actual password
MONGODB_URI=mongodb+srv://psalm10435_db_user:<db_password>@cluster0moyora.ygdtvkv.mongodb.net/?appName=Cluster0moyora

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# PortOne V2 결제 (포트원 콘솔 > 결제 연동에서 발급)
# 세 값이 모두 있으면 실결제/정기결제, 없으면 데모 결제로 동작합니다.
# 카드 정기결제(빌링키)를 지원하는 채널을 사용해야 합니다.
PORTONE_API_SECRET=your_portone_api_secret_here       # 서버 전용 (결제 검증/청구)
NEXT_PUBLIC_PORTONE_STORE_ID=your_portone_store_id_here     # 상점 ID
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=your_portone_channel_key_here # 결제 채널 키

# Vercel Cron (알림/자동삭제/정기결제 청구에 필요)
CRON_SECRET=your_random_cron_secret_here
